# Optional local configuration. Copy to .env (ignored by Git).
# This app does not parse .env automatically. With Node.js 20.6+ use:
#   node --env-file=.env server.mjs
# or:
#   node --env-file=.env scripts/launch.mjs
# Existing process environment variables take precedence over --env-file.
# Never place login tokens or API keys in this project. Use your own Codex login.

PORT=4317
# READER_DATA=./.reader-data
# READER_PYTHON=/absolute/path/to/python
# CODEX_EXECUTABLE=/absolute/path/to/codex
# CODEX_HOME=/absolute/path/to/your/existing/.codex

# Models must be available to your own Codex account. The examples below inherit
# your existing Codex configuration; remove the comment marker to enable them.
# READER_MODEL_FAST=inherit
# READER_MODEL_BALANCED=inherit
# READER_MODEL_CAREFUL=inherit
# READER_EFFORT_FAST=low
# READER_EFFORT_BALANCED=low
# READER_EFFORT_CAREFUL=medium
# An effort value of inherit omits the per-request effort override.
# App-owned queue requests still inherit the owner's actual configuration.
